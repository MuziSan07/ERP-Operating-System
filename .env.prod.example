# Copy to .env.prod (git-ignored) and fill in real values for docker-compose.prod.yml.
# Generate secrets with e.g.:  openssl rand -base64 48
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
JWT_KEY=at-least-32-random-characters-change-me
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=choose-a-strong-password-12+
PUBLIC_URL=https://erp.example.com
ALLOWED_HOSTS=erp.example.com
HTTP_PORT=80
BACKUP_KEEP_DAYS=14
